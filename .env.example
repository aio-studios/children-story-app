# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Claude API key (Anthropic) - used for story generation. Leave blank until we build the feature that needs it.
ANTHROPIC_API_KEY=

# Google AI Studio key (Gemini 2.5 Flash Image) - used for optional story cover illustrations (#38).
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel Blob store token - where generated cover images are stored (#38).
BLOB_READ_WRITE_TOKEN=

