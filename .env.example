# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Claude API key (Anthropic) - used for story generation. Leave blank until we build the feature that needs it.
ANTHROPIC_API_KEY=

# Google AI Studio key (Gemini 2.5 Flash Image) - used for optional story cover illustrations (#38).
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel Blob store token - where generated cover images are stored (#38).
BLOB_READ_WRITE_TOKEN=

# Supabase - accounts + story library (#92). Both are public-by-design and ship in the browser
# bundle; Row Level Security is what actually protects data. Never add the service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret Vercel sends as `Authorization: Bearer <secret>` on cron invocations, so the
# Supabase keep-alive ping isn't a public endpoint. Set on Vercel only - leave blank locally.
CRON_SECRET=
